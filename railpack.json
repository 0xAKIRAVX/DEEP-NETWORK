{
  "$schema": "https://schema.railpack.com",
  "buildAptPackages": [
    "...",
    "curl",
    "unzip",
    "ca-certificates"
  ],
  "steps": {
    "xray": {
      "commands": [
        "curl -fsSL https://github.com/XTLS/Xray-core/releases/latest/download/Xray-linux-64.zip -o /tmp/xray.zip",
        "mkdir -p bin",
        "unzip -o /tmp/xray.zip xray -d bin",
        "chmod +x bin/xray",
        "bin/xray version"
      ],
      "deployOutputs": [
        {
          "include": [
            "bin"
          ]
        }
      ]
    }
  },
  "deploy": {
    "startCommand": "./out",
    "aptPackages": [
      "...",
      "ca-certificates",
      "tzdata"
    ],
    "variables": {
      "TZ": "UTC"
    }
  }
}
